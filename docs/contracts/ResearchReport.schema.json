{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "description": "A resolvable source supporting a claim or a rule.",
      "properties": {
        "citation_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citation Id"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "quote": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Quote"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "url": {
          "minLength": 1,
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "title",
        "url"
      ],
      "title": "Citation",
      "type": "object"
    },
    "MissingPolicy": {
      "enum": [
        "unknown",
        "false"
      ],
      "title": "MissingPolicy",
      "type": "string"
    },
    "RuleOp": {
      "enum": [
        "gt",
        "ge",
        "lt",
        "le",
        "eq",
        "ne",
        "in",
        "not_in",
        "between",
        "is_true",
        "is_false"
      ],
      "title": "RuleOp",
      "type": "string"
    },
    "RuleSpec": {
      "additionalProperties": false,
      "description": "A whitelisted, deterministic predicate over one admitted field.",
      "properties": {
        "field": {
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "missing_policy": {
          "$ref": "#/$defs/MissingPolicy",
          "default": "unknown"
        },
        "op": {
          "$ref": "#/$defs/RuleOp"
        },
        "units": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Units"
        },
        "value": {
          "default": null,
          "title": "Value"
        },
        "value2": {
          "default": null,
          "title": "Value2"
        }
      },
      "required": [
        "field",
        "op"
      ],
      "title": "RuleSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A provider's answer for exactly one candidate precondition.\n\nEither ``proposed_rule`` is present (the candidate is operationalizable) or\n``rejection_reason`` explains why it is not. Both being present is allowed\nonly when the report is explicitly rejected, so the gate can record the\nproposed but unusable rule.",
  "properties": {
    "candidate_key": {
      "minLength": 1,
      "title": "Candidate Key",
      "type": "string"
    },
    "citations": {
      "items": {
        "$ref": "#/$defs/Citation"
      },
      "title": "Citations",
      "type": "array"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "proposed_rule": {
      "anyOf": [
        {
          "$ref": "#/$defs/RuleSpec"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "provider": {
      "minLength": 1,
      "title": "Provider",
      "type": "string"
    },
    "raw_text": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Raw Text"
    },
    "rejection_reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Rejection Reason"
    },
    "report_id": {
      "minLength": 1,
      "title": "Report Id",
      "type": "string"
    },
    "reported_effect_sizes": {
      "additionalProperties": true,
      "title": "Reported Effect Sizes",
      "type": "object"
    },
    "required_fields": {
      "items": {
        "type": "string"
      },
      "title": "Required Fields",
      "type": "array"
    },
    "summary": {
      "minLength": 1,
      "title": "Summary",
      "type": "string"
    },
    "title": {
      "minLength": 1,
      "title": "Title",
      "type": "string"
    }
  },
  "required": [
    "report_id",
    "candidate_key",
    "provider",
    "title",
    "summary",
    "created_at"
  ],
  "title": "ResearchReport",
  "type": "object"
}
