{
  "$defs": {
    "FavoriteSource": {
      "enum": [
        "cfbd_open",
        "espn_open",
        "strength_proxy"
      ],
      "title": "FavoriteSource",
      "type": "string"
    },
    "GameStatus": {
      "enum": [
        "scheduled",
        "in_progress",
        "final",
        "postponed",
        "canceled"
      ],
      "title": "GameStatus",
      "type": "string"
    },
    "MarketProbSource": {
      "enum": [
        "moneyline",
        "spread_mapped",
        "unavailable"
      ],
      "title": "MarketProbSource",
      "type": "string"
    },
    "OddsInfo": {
      "additionalProperties": false,
      "description": "Pre-kickoff market context.\n\n``spread`` is from the favourite's perspective (negative = favourite gives\npoints). Opening/closing distinction is carried by ``known_at`` so the\nleakage filter can exclude anything known at or after kickoff.",
      "properties": {
        "favorite_source": {
          "$ref": "#/$defs/FavoriteSource"
        },
        "favorite_team_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Favorite Team Id"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "line_provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Line Provider"
        },
        "market_prob": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Market Prob"
        },
        "market_prob_source": {
          "$ref": "#/$defs/MarketProbSource",
          "default": "unavailable"
        },
        "over_under": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Over Under"
        },
        "provider": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider"
        },
        "spread": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread"
        },
        "spread_open": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Spread Open"
        }
      },
      "required": [
        "favorite_source",
        "known_at"
      ],
      "title": "OddsInfo",
      "type": "object"
    },
    "Provenance": {
      "additionalProperties": false,
      "description": "Where a value came from and when it was knowable.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "content_hash": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Content Hash"
        },
        "fetched_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fetched At"
        },
        "known_at": {
          "format": "date-time",
          "title": "Known At",
          "type": "string"
        },
        "published_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Published At"
        },
        "source": {
          "title": "Source",
          "type": "string"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Url"
        }
      },
      "required": [
        "source",
        "known_at"
      ],
      "title": "Provenance",
      "type": "object"
    },
    "TeamInfo": {
      "additionalProperties": false,
      "properties": {
        "abbreviation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abbreviation"
        },
        "alt_color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Alt Color"
        },
        "color": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Color"
        },
        "conference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conference"
        },
        "is_fbs": {
          "default": true,
          "title": "Is Fbs",
          "type": "boolean"
        },
        "logo_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Logo Url"
        },
        "nickname": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Nickname"
        },
        "rank": {
          "anyOf": [
            {
              "maximum": 25,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rank"
        },
        "record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record"
        },
        "school": {
          "minLength": 1,
          "title": "School",
          "type": "string"
        },
        "team_id": {
          "minLength": 1,
          "title": "Team Id",
          "type": "string"
        }
      },
      "required": [
        "team_id",
        "school"
      ],
      "title": "TeamInfo",
      "type": "object"
    },
    "VenueInfo": {
      "additionalProperties": false,
      "properties": {
        "altitude_m": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Altitude M"
        },
        "city": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "City"
        },
        "country": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country"
        },
        "grass": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Grass"
        },
        "indoor": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Indoor"
        },
        "lat": {
          "anyOf": [
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lat"
        },
        "lon": {
          "anyOf": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lon"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "state": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "State"
        },
        "tz": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tz"
        },
        "venue_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue Id"
        }
      },
      "required": [
        "name"
      ],
      "title": "VenueInfo",
      "type": "object"
    },
    "WeatherInfo": {
      "additionalProperties": false,
      "properties": {
        "condition": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Condition"
        },
        "known_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Known At"
        },
        "lead_hours": {
          "anyOf": [
            {
              "maximum": 168.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lead Hours"
        },
        "precipitation_mm": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precipitation Mm"
        },
        "source": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source"
        },
        "temperature_c": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temperature C"
        },
        "unavailable_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unavailable Reason"
        },
        "wind_kph": {
          "anyOf": [
            {
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Wind Kph"
        }
      },
      "title": "WeatherInfo",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One completed or scheduled FBS-vs-FBS game in the historical corpus.\n\n``home_score``/``away_score`` and ``team_stats`` are stored for labels and\nevaluation only. They are deliberately separate from ``field_provenance``\nso no feature builder can mistake a post-game value for a pre-kickoff one.",
  "properties": {
    "away": {
      "$ref": "#/$defs/TeamInfo"
    },
    "away_score": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Away Score"
    },
    "conference_game": {
      "default": false,
      "title": "Conference Game",
      "type": "boolean"
    },
    "fetched_at": {
      "format": "date-time",
      "title": "Fetched At",
      "type": "string"
    },
    "field_provenance": {
      "additionalProperties": {
        "$ref": "#/$defs/Provenance"
      },
      "title": "Field Provenance",
      "type": "object"
    },
    "game_id": {
      "minLength": 1,
      "title": "Game Id",
      "type": "string"
    },
    "home": {
      "$ref": "#/$defs/TeamInfo"
    },
    "home_score": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Home Score"
    },
    "is_fbs_vs_fbs": {
      "default": true,
      "title": "Is Fbs Vs Fbs",
      "type": "boolean"
    },
    "kickoff_utc": {
      "format": "date-time",
      "title": "Kickoff Utc",
      "type": "string"
    },
    "neutral_site": {
      "default": false,
      "title": "Neutral Site",
      "type": "boolean"
    },
    "odds": {
      "anyOf": [
        {
          "$ref": "#/$defs/OddsInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "season": {
      "maximum": 3000,
      "minimum": 1869,
      "title": "Season",
      "type": "integer"
    },
    "season_type": {
      "default": 2,
      "title": "Season Type",
      "type": "integer"
    },
    "source": {
      "default": "espn",
      "title": "Source",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/GameStatus",
      "default": "scheduled"
    },
    "team_stats": {
      "additionalProperties": {
        "additionalProperties": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "type": "object"
      },
      "title": "Team Stats",
      "type": "object"
    },
    "venue": {
      "anyOf": [
        {
          "$ref": "#/$defs/VenueInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "weather": {
      "anyOf": [
        {
          "$ref": "#/$defs/WeatherInfo"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "week": {
      "anyOf": [
        {
          "maximum": 30,
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Week"
    },
    "winner_team_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Winner Team Id"
    }
  },
  "required": [
    "game_id",
    "season",
    "kickoff_utc",
    "home",
    "away",
    "fetched_at"
  ],
  "title": "HistoricalGameRecord",
  "type": "object"
}
